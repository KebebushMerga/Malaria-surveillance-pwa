:root {
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172b2f;
  background: #f4f7f8;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  min-height: 100vh;
  background: #f4f7f8;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
}

/* =========================
   LOGIN
========================= */

.login-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f4f7f8;
}

.login-visual {
  min-height: 100vh;
  background: linear-gradient(
    145deg,
    #0f3d3e,
    #176b62
  );
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 60px;
}

.login-visual-content {
  max-width: 520px;
}

.login-visual-logo {
  width: 110px;
  height: 110px;
  border-radius: 24px;
  object-fit: cover;
  margin-bottom: 28px;
}

.login-visual h1 {
  font-size: 42px;
  line-height: 1.1;
  margin: 0 0 18px;
}

.login-visual p {
  font-size: 18px;
  line-height: 1.7;
  opacity: 0.9;
}

.login-form-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.login-card {
  width: 100%;
  max-width: 430px;
  background: white;
  border-radius: 18px;
  padding: 38px;

  box-shadow:
    0 20px 50px rgba(15, 61, 62, 0.1);
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 30px;
}

.login-brand img {
  width: 58px;
  height: 58px;
  object-fit: cover;
  border-radius: 14px;
}

.login-brand h1 {
  margin: 0;
  font-size: 22px;
  color: #0f3d3e;
}

.login-brand p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 13px;
}

/* =========================
   FORMS
========================= */

.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  margin-bottom: 7px;
  font-weight: 600;
  font-size: 14px;
  color: #344054;
}

.form-control {
  width: 100%;
  padding: 12px 14px;

  border: 1px solid #d0d5dd;
  border-radius: 9px;

  outline: none;
  background: white;

  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.form-control:focus {
  border-color: #0f766e;

  box-shadow:
    0 0 0 3px rgba(15, 118, 110, 0.12);
}

.primary-button {
  width: 100%;
  border: none;
  border-radius: 9px;

  padding: 13px 18px;

  background: #0f766e;
  color: white;

  font-weight: 600;

  transition:
    background 0.2s,
    transform 0.1s;
}

.primary-button:hover {
  background: #0b5f59;
}

.primary-button:active {
  transform: translateY(1px);
}

.primary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.error-message {
  background: #fef3f2;
  color: #b42318;

  border: 1px solid #fecdca;

  border-radius: 8px;

  padding: 11px 13px;

  margin-bottom: 16px;

  font-size: 14px;
}

/* =========================
   APPLICATION LAYOUT
========================= */

.app-shell {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 250px;
  min-height: 100vh;

  background: #0f3d3e;
  color: white;

  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;

  display: flex;
  flex-direction: column;

  z-index: 20;
}

.sidebar-brand {
  padding: 24px 20px;

  display: flex;
  align-items: center;
  gap: 12px;

  border-bottom: 1px solid
    rgba(255, 255, 255, 0.1);
}

.sidebar-brand img {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  object-fit: cover;
}

.sidebar-brand strong {
  font-size: 16px;
}

.sidebar-brand span {
  display: block;
  margin-top: 3px;
  color: #b9d7d3;
  font-size: 11px;
}

.sidebar-nav {
  padding: 18px 12px;

  display: flex;
  flex-direction: column;

  gap: 5px;

  flex: 1;
}

.nav-item {
  display: block;

  padding: 11px 14px;

  border-radius: 8px;

  text-decoration: none;

  color: #c6ddda;

  font-size: 14px;
  font-weight: 500;

  transition:
    background 0.2s,
    color 0.2s;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.nav-item.active {
  background: #176b62;
  color: white;
}

.sidebar-footer {
  padding: 16px;

  border-top: 1px solid
    rgba(255, 255, 255, 0.1);
}

.main-area {
  margin-left: 250px;
  width: calc(100% - 250px);
  min-height: 100vh;
}

.topbar {
  height: 70px;

  background: white;

  border-bottom: 1px solid #e4e7ec;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 30px;

  position: sticky;
  top: 0;
  z-index: 10;
}

.topbar-title {
  font-size: 18px;
  font-weight: 700;
  color: #172b2f;
}

.topbar-user {
  display: flex;
  align-items: center;
  gap: 12px;

  font-size: 14px;
}

.role-badge {
  padding: 5px 9px;

  background: #ecfdf3;
  color: #027a48;

  border-radius: 20px;

  font-size: 12px;
  font-weight: 600;
}

.page-content {
  padding: 30px;
  max-width: 1500px;
  margin: 0 auto;
}

/* =========================
   PAGE HEADERS
========================= */

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 28px;
}

.page-header h1 {
  margin: 0;

  color: #172b2f;

  font-size: 28px;
}

.page-header p {
  margin: 7px 0 0;

  color: #667085;

  font-size: 14px;
}

/* =========================
   CARDS
========================= */

.card {
  background: white;

  border: 1px solid #e4e7ec;

  border-radius: 14px;

  padding: 22px;

  box-shadow:
    0 3px 10px rgba(16, 24, 40, 0.03);
}

.card h2,
.card h3 {
  margin-top: 0;
}

.stats-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(210px, 1fr));

  gap: 18px;

  margin-bottom: 24px;
}

.stat-card {
  background: white;

  border: 1px solid #e4e7ec;

  border-radius: 14px;

  padding: 20px;
}

.stat-card-label {
  color: #667085;
  font-size: 13px;
}

.stat-card-value {
  display: block;

  margin-top: 8px;

  font-size: 30px;

  font-weight: 700;

  color: #0f766e;
}

/* =========================
   TABLES
========================= */

.table-container {
  width: 100%;
  overflow-x: auto;

  background: white;

  border: 1px solid #e4e7ec;

  border-radius: 12px;
}

table {
  width: 100%;

  border-collapse: collapse;

  min-width: 650px;
}

thead {
  background: #f9fafb;
}

th {
  text-align: left;

  padding: 13px 16px;

  color: #475467;

  font-size: 12px;

  font-weight: 600;

  text-transform: uppercase;

  letter-spacing: 0.03em;
}

td {
  padding: 14px 16px;

  border-top: 1px solid #eaecf0;

  color: #344054;

  font-size: 14px;
}

tbody tr:hover {
  background: #f9fafb;
}

/* =========================
   BADGES
========================= */

.status-badge {
  display: inline-flex;

  padding: 5px 9px;

  border-radius: 20px;

  font-size: 12px;

  font-weight: 600;
}

.status-active {
  background: #ecfdf3;
  color: #027a48;
}

.status-inactive {
  background: #fef3f2;
  color: #b42318;
}

.status-warning {
  background: #fffaeb;
  color: #b54708;
}

/* =========================
   REPORTS
========================= */

.report-card {
  background: white;

  border: 1px solid #e4e7ec;

  border-radius: 14px;

  padding: 22px;

  display: flex;

  flex-direction: column;

  gap: 8px;
}

.report-card span {
  color: #667085;
  font-size: 13px;
}

.report-card strong {
  font-size: 30px;
  color: #0f766e;
}

.report-panel {
  background: white;

  border: 1px solid #e4e7ec;

  border-radius: 14px;

  padding: 22px;
}

.report-panel h2 {
  margin-top: 0;

  font-size: 18px;
}

.stat-row {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 13px 0;

  border-bottom: 1px solid #eef0f2;
}

.stat-row:last-child {
  border-bottom: none;
}

.stat-row span {
  color: #667085;
}

/* =========================
   ALERTS
========================= */

.alert {
  border-radius: 9px;

  padding: 12px 14px;

  margin-bottom: 18px;

  font-size: 14px;
}

.alert-error {
  background: #fef3f2;
  border: 1px solid #fecdca;
  color: #b42318;
}

.alert-success {
  background: #ecfdf3;
  border: 1px solid #abefc6;
  color: #027a48;
}

.alert-warning {
  background: #fffaeb;
  border: 1px solid #fedf89;
  color: #b54708;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {
  .login-page {
    grid-template-columns: 1fr;
  }

  .login-visual {
    display: none;
  }

  .login-form-section {
    min-height: 100vh;
  }

  .sidebar {
    width: 210px;
  }

  .main-area {
    margin-left: 210px;
    width: calc(100% - 210px);
  }
}

@media (max-width: 700px) {
  .sidebar {
    position: static;

    width: 100%;

    min-height: auto;
  }

  .app-shell {
    display: block;
  }

  .main-area {
    margin-left: 0;

    width: 100%;
  }

  .sidebar-nav {
    flex-direction: row;

    overflow-x: auto;

    padding: 10px;
  }

  .nav-item {
    white-space: nowrap;
  }

  .sidebar-footer {
    display: none;
  }

  .topbar {
    padding: 0 16px;
  }

  .page-content {
    padding: 18px;
  }

  .page-header {
    flex-direction: column;
  }

  .login-card {
    padding: 25px;
  }

  .login-brand h1 {
    font-size: 19px;
  }
}

.sidebar-footer {
  padding: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.user-summary {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin-bottom: 12px;
}

.user-summary strong {
  font-size: 14px;
  color: white;
}

.user-summary span {
  font-size: 12px;
  color: #b9d7d3;
}

.logout-button {
  width: 100%;
  padding: 10px 12px;

  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;

  background: rgba(255, 255, 255, 0.06);
  color: white;

  font-weight: 600;
}

.logout-button:hover {
  background: rgba(255, 255, 255, 0.12);
}

.notification-link {
  text-decoration: none;
  color: #0f766e;
  font-weight: 600;
}

.notification-link:hover {
  color: #0b5f59;
}
.stat-card p {
  margin: 8px 0 0;
  color: #667085;
  font-size: 13px;
}

.stat-card:hover,
.report-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(16, 24, 40, 0.07);
}

.stat-card,
.report-card {
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.status-danger {
  background: #fef3f2;
  color: #b42318;
}

.status-warning {
  background: #fffaeb;
  color: #b54708;
}
.status-success {
  display: inline-flex;
  align-items: center;
  padding: 4px 9px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #027a48;
  font-size: 12px;
  font-weight: 700;
}

.status-inactive {
  display: inline-flex;
  align-items: center;
  padding: 4px 9px;
  border-radius: 999px;
  background: #f2f4f7;
  color: #475467;
  font-size: 12px;
  font-weight: 700;
}
.notification-item {
  display: flex;
  gap: 15px;
  padding: 18px;
  border: 1px solid #eaecf0;
  border-radius: 12px;
  transition: 0.2s ease;
}

.notification-item:hover {
  border-color: #cbd5e1;
  box-shadow: 0 3px 12px rgba(16, 24, 40, 0.05);
}

.notification-item.unread {
  background: #f8fffc;
  border-left: 4px solid #0f766e;
}

.notification-item.read {
  background: #ffffff;
}

.notification-icon {
  width: 40px;
  height: 40px;
  min-width: 40px;
  border-radius: 10px;
  background: #ecfdf3;
  color: #047857;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 18px;
}

.notification-type {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.notification-type.outbreak {
  background: #fef3f2;
  color: #b42318;
}

.notification-type.system {
  background: #fff7ed;
  color: #c2410c;
}

.notification-type.information {
  background: #eff8ff;
  color: #175cd3;
}
/* =========================
   Reports & Analytics
   ========================= */

.report-grid {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(320px, 1fr)
  );
  gap: 20px;
  margin-bottom: 20px;
}

.report-panel {
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 14px;
  padding: 22px;
  margin-bottom: 20px;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.panel-header h2 {
  margin: 0 0 5px;
  font-size: 18px;
  color: #101828;
}

.panel-header p {
  margin: 0;
  color: #667085;
  font-size: 13px;
}

.filter-button {
  border: 1px solid #d0d5dd;
  background: #ffffff;
  color: #344054;
  padding: 9px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.filter-button:hover {
  border-color: #0f766e;
}

.filter-button.active {
  background: #ecfdf3;
  border-color: #0f766e;
  color: #047857;
}

.demographic-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.demographic-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f2f4f7;
}

.demographic-row:last-child {
  border-bottom: none;
}

.demographic-row > div {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #475467;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.male-dot {
  background: #2563eb;
}

.female-dot {
  background: #db2777;
}

.other-dot {
  background: #98a2b3;
}

.facility-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.facility-summary-item {
  padding: 16px;
  background: #f8fafc;
  border-radius: 10px;
}

.facility-summary-item strong {
  display: block;
  font-size: 25px;
  color: #101828;
}

.facility-summary-item span {
  color: #667085;
  font-size: 13px;
}

.coverage-bar {
  height: 9px;
  background: #eaecf0;
  border-radius: 999px;
  overflow: hidden;
  margin-top: 22px;
}

.coverage-bar div {
  height: 100%;
  background: #0f766e;
  border-radius: 999px;
}

.coverage-text {
  color: #667085;
  font-size: 13px;
  margin-top: 8px;
}

.analytics-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.analytics-item {
  width: 100%;
}

.analytics-label {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 7px;
  color: #475467;
  font-size: 14px;
}

.analytics-label span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analytics-bar {
  width: 100%;
  height: 8px;
  background: #f2f4f7;
  border-radius: 999px;
  overflow: hidden;
}

.analytics-bar div {
  height: 100%;
  background: #0f766e;
  border-radius: 999px;
  min-width: 3px;
}

.empty-report {
  padding: 40px 15px;
  text-align: center;
  color: #667085;
  background: #f8fafc;
  border-radius: 10px;
}

.case-status {
  display: inline-flex;
  padding: 4px 9px;
  border-radius: 999px;
  background: #eff8ff;
  color: #175cd3;
  font-size: 12px;
  font-weight: 600;
}

@media (max-width: 700px) {
  .facility-summary {
    grid-template-columns: 1fr;
  }

  .filter-button {
    flex: 1;
  }
}
/* =========================================
   DASHBOARD QUICK ACTIONS
========================================= */

.quick-action {
  display: flex;
  flex-direction: column;
  gap: 6px;

  padding: 18px;

  text-decoration: none;

  border: 1px solid #e4e7ec;
  border-radius: 10px;

  background: #f8fafc;

  color: #101828;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.quick-action strong {
  font-size: 15px;
  color: #0f766e;
}

.quick-action span {
  font-size: 13px;
  color: #667085;
}

.quick-action:hover {
  transform: translateY(-2px);

  background: #f0fdfa;

  border-color: #99f6e4;

  box-shadow:
    0 4px 12px rgba(16, 24, 40, 0.08);
}
/* =========================================
   NOTIFICATIONS
========================================= */

.notification-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.notification-toolbar h2 {
  margin: 0 0 5px;
}

.notification-toolbar p {
  margin: 0;
  color: #667085;
  font-size: 14px;
}

.notification-filters {
  display: flex;
  gap: 8px;
}

.filter-button {
  padding: 9px 16px;
  border: 1px solid #d0d5dd;
  border-radius: 8px;
  background: white;
  color: #344054;
  font-weight: 600;
  cursor: pointer;
}

.filter-button:hover {
  background: #f9fafb;
}

.filter-button.active {
  border-color: #0f766e;
  background: #ecfdf3;
  color: #047857;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.notification-item {
  display: flex;
  gap: 15px;
  padding: 18px;
  border: 1px solid #eaecf0;
  border-radius: 12px;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.notification-item.unread {
  background: #f8fffd;
  border-color: #b2e8df;
}

.notification-item.read {
  background: #ffffff;
}

.notification-item:hover {
  box-shadow:
    0 3px 10px rgba(16, 24, 40, 0.06);
}

.notification-icon {
  width: 42px;
  height: 42px;
  min-width: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-size: 18px;
  font-weight: 800;
}

.notification-icon.outbreak {
  background: #fef3f2;
  color: #d92d20;
}

.notification-icon.system {
  background: #eff8ff;
  color: #175cd3;
}

.notification-icon.information {
  background: #ecfdf3;
  color: #047857;
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.notification-top h3 {
  margin: 8px 0 5px;
  font-size: 16px;
  color: #101828;
}

.notification-type {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 700;
}

.notification-type.outbreak {
  background: #fef3f2;
  color: #b42318;
}

.notification-type.system {
  background: #eff8ff;
  color: #175cd3;
}

.notification-type.information {
  background: #ecfdf3;
  color: #047857;
}

.unread-dot {
  width: 9px;
  height: 9px;
  min-width: 9px;
  margin-top: 7px;

  border-radius: 50%;

  background: #0f766e;
}

.notification-message {
  margin: 0 0 12px;
  color: #475467;
  line-height: 1.6;
}

.notification-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
}

.notification-date {
  color: #98a2b3;
  font-size: 12px;
}

.mark-read-button {
  padding: 0;
  border: none;
  background: transparent;
  color: #0f766e;
  font-weight: 700;
  cursor: pointer;
}

.mark-read-button:hover {
  color: #065f5b;
  text-decoration: underline;
}

.mark-read-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.notification-empty {
  text-align: center;
  padding: 60px 20px;
  color: #667085;
}

.notification-empty-icon {
  width: 54px;
  height: 54px;
  margin: 0 auto 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #ecfdf3;
  color: #047857;

  font-size: 25px;
  font-weight: 800;
}

.notification-empty h3 {
  margin-bottom: 8px;
  color: #344054;
}

.notification-empty p {
  margin: 0;
}